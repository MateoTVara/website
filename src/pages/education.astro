---
import BaseLayout from "@/layouts/BaseLayout.astro";
import EducationCard from "@/components/EducationCard.astro";
import CertificationCard from "@/components/CertificationCard.astro";
import { education } from "@/lib/consts/education";
import { certifications } from "@/lib/consts/certifications";
---

<BaseLayout>
  <div class="flex flex-col gap-4">
    <section class="flex flex-col gap-2">
      {education.map((education) => <EducationCard {education} />)}
    </section>
    <section class="grid grid-cols-2 gap-2 sm:grid-cols-3">
      <h2 class="col-span-full text-lg font-bold">certificaciones</h2>
      {
        certifications.map((certification) => (
          <CertificationCard {certification} />
        ))
      }
    </section>
  </div>
</BaseLayout>
