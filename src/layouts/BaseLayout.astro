---
import "../styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
---

<!doctype html>
<html lang="es">
  <BaseHead />
  <body
    class="font-maple bg-bg text-fg flex min-h-dvh flex-col items-center p-5 font-extralight"
  >
    <main
      class="outline-fg-lighter/15 border-fg-lighter/25 my-4 w-full max-w-4xl border px-5 py-6 outline outline-offset-4 sm:my-12 sm:px-10 sm:pt-7 sm:pb-8"
    >
      <div class="mb-6">
        <Header />
      </div>
      <slot />
    </main>
  </body>
</html>
