---
import "../styles/global.css";
import BaseHead from "@/components/BaseHead.astro";
import Header from "@/components/Header.astro";
---

<!doctype html>
<html lang="es">
  <BaseHead />
  <body class="font-maple flex min-h-dvh flex-col items-center p-5">
    <div class="my-4 border p-1 sm:my-12">
      <main
        class="w-full max-w-4xl border-2 px-5 py-6 sm:px-10 sm:pt-7 sm:pb-8"
      >
        <div class="mb-6">
          <Header />
        </div>
        <slot />
      </main>
    </div>
  </body>
</html>
