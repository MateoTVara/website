---
import type { Social } from "@/lib/types/Social";
import { Icon } from "astro-icon/components";

type Props = {
  social: Social;
};

const { social } = Astro.props;
---

<a
  href={social.url}
  target="_blank"
  rel="me noopener noreferrer"
  class="border-fg-lighter/25 group hover:border-special flex items-center gap-2 border px-3 py-4 transition-colors sm:gap-3"
>
  <Icon
    name={social.icon}
    class="group-hover:text-special shrink-0"
    size={28}
  />
  <div class="flex min-w-0 flex-col sm:gap-1">
    <span class="group-hover:text-special font-semibold">{social.name}</span>
    <span class="text-fg-lighter/80 truncate font-extralight"
      >{social.username}</span
    >
  </div>
</a>
