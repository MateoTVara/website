---
import type { Education } from "@/lib/types/Education";

type Props = {
  education: Education;
};

const { education } = Astro.props;
---

<a
  href={education.institutionUrl}
  rel="noopener noreferrer"
  target="_blank"
  class="group hover:border-special border-fg-lighter/25 border px-3 py-2 transition-colors"
>
  <div class="flex flex-col justify-between sm:flex-row sm:flex-wrap">
    <h3 class="group-hover:text-special font-medium">{education.title}</h3>
    <span class="text-sm">{education.period}</span>
  </div>
  <span class="text-fg-lighter/75 text-sm">{education.institution}</span>
</a>
