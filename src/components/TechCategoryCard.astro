---
import type { TechnologyCategory } from "@/lib/types/TechnologyCategorygory";
import TechIcon from "./TechIcon.astro";

type Props = {
  techCategory: TechnologyCategory;
};

const { techCategory } = Astro.props;
---

<div class="border px-2 py-1">
  <h3 class="text-lg font-semibold">{techCategory.name}</h3>
  <div class="flex flex-wrap justify-end gap-3">
    {techCategory.technologies.map((tech) => <TechIcon tech={tech} />)}
  </div>
</div>
