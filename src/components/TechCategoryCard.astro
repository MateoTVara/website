---
import type { TechnologyCategory } from "@/lib/types/TechnologyCategory";
import TechIcon from "./TechIcon.astro";

type Props = {
  techCategory: TechnologyCategory;
};

const { techCategory } = Astro.props;
---

<div
  class="group border-fg-lighter/25 hover:border-special border px-2 pt-1 pb-2 transition-colors"
>
  <h3 class="group-hover:text-special text-lg font-medium transition-colors">
    {techCategory.name}
  </h3>
  <div class="flex flex-wrap justify-end gap-3">
    {techCategory.technologies.map((tech) => <TechIcon tech={tech} />)}
  </div>
</div>
