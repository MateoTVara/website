---
import { Image } from "astro:assets";

type NavItem = {
  name: string;
  url: string;
};

const NAV_ITEMS: NavItem[] = [
  { name: "home", url: "/" },
  { name: "experiencia", url: "/experience" },
  { name: "educación", url: "/education" },
  { name: "proyectos", url: "/projects" },
];
---

<header
  class="flex flex-col gap-4 border-b pb-3 md:flex-row md:justify-between md:pb-4"
>
  <a href="/" class="flex items-center gap-3">
    <Image
      src="/me.webp"
      alt="Mateo Torres Vara"
      width={56}
      height={56}
      class="rounded-full border"
    />
    <span class="text-xl">mateo torres vara</span>
  </a>
  <nav class="flex w-fit flex-wrap items-center gap-2 self-end md:self-center">
    {
      NAV_ITEMS.map(({ name, url }) => (
        <a href={url} class="border px-2 py-0.5">
          {name}
        </a>
      ))
    }
  </nav>
</header>
