---
import { Image } from "astro:assets";

type NavItem = {
  name: string;
  href: string;
};

const nav_items: NavItem[] = [
  { name: "home", href: "/" },
  { name: "experiencia", href: "/experience" },
  { name: "educación", href: "/education" },
  { name: "proyectos", href: "/projects" },
];

const path = Astro.url.pathname;
---

<header
  class="border-fg-lighter/25 flex flex-col gap-4 border-b pb-3 md:flex-row md:justify-between md:pb-4"
>
  <a href="/" class="flex items-center gap-3">
    <Image
      src="/me.webp"
      alt="Mateo Torres Vara"
      width={56}
      height={56}
      class="rounded-full border"
    />
    <span class="text-xl font-bold tracking-wider">mateo torres vara</span>
  </a>
  <nav class="flex w-fit flex-wrap items-center gap-2 self-end md:self-center">
    {
      nav_items.map(({ name, href }) => (
        <a
          href={href}
          class:list={[
            "border-fg-lighter/25 hover:border-special hover:text-special border px-2.5 py-1 text-sm transition-colors",
            href === path && "border-special text-special",
          ]}
        >
          {name}
        </a>
      ))
    }
  </nav>
</header>
